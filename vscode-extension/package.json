{
  "name": "synapses",
  "displayName": "Synapses",
  "description": "Graph-based code context for AI coding agents — hover to inspect callers, callees, and metadata",
  "version": "0.1.0",
  "publisher": "synapses",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["ai", "context", "graph", "mcp"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "synapses.showEntity",
        "title": "Synapses: Show Entity Context"
      },
      {
        "command": "synapses.reindex",
        "title": "Synapses: Re-index Project"
      }
    ],
    "configuration": {
      "title": "Synapses",
      "properties": {
        "synapses.binaryPath": {
          "type": "string",
          "default": "synapses",
          "description": "Path to the synapses binary (defaults to 'synapses' on PATH)"
        },
        "synapses.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Show Synapses context in hover tooltips"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
