FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
COPY synapses_linux_arm64 /usr/local/bin/synapses
RUN chmod +x /usr/local/bin/synapses
RUN mkdir -p /root/.synapses/cache
EXPOSE 11435
ENV SYNAPSES_BIND_ADDR=0.0.0.0:11435
ENV SYNAPSES_NO_AUTH=1
CMD ["synapses", "daemon", "serve"]
