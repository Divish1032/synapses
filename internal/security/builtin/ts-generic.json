{
  "patterns": [
    {
      "id": "ts-generic-hardcoded-secret",
      "name": "Hardcoded secret or credential in TypeScript/JavaScript source",
      "language": "typescript",
      "framework": "*",
      "pattern_type": "hardcoded_secret",
      "severity": "CRITICAL",
      "description": "A string literal that looks like a credential (JWT secret, API key, password) is assigned directly in source rather than loaded from environment variables. This exposes credentials in version control and build artifacts.",
      "detection": {
        "check_type": "hardcoded_secret",
        "secret_patterns": [
          "(?i)^[a-zA-Z0-9+/]{32,}={0,2}$",
          "^sk-[a-zA-Z0-9]{32,}$",
          "^sk-proj-[a-zA-Z0-9_-]{20,}$",
          "^ghp_[a-zA-Z0-9]{36}$",
          "^ghs_[a-zA-Z0-9]{36}$",
          "^eyJ[a-zA-Z0-9_-]{10,}\\.[a-zA-Z0-9_-]{10,}\\.[a-zA-Z0-9_-]{10,}$",
          "^AKIA[0-9A-Z]{16}$",
          "^sk_live_[a-zA-Z0-9]{24,}$",
          "^xox[bprs]-[0-9A-Za-z-]{20,}$",
          "^AIza[0-9A-Za-z_-]{35}$",
          "(?i)^postgres(?:ql)?://[^:/]+:[^@/]{4,}@",
          "(?i)^mysql://[^:/]+:[^@/]{4,}@",
          "(?i)^mongodb(?:\\+srv)?://[^:/]+:[^@/]{4,}@",
          "(?i)^amqps?://[^:/]+:[^@/]{4,}@",
          "(?i)^redis://[^:/]*:[^@/]{4,}@",
          "^SG\\.[a-zA-Z0-9_-]{22,}\\.[a-zA-Z0-9_-]{22,}$",
          "^key-[a-zA-Z0-9]{32,}$",
          "^-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
          "^https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[a-zA-Z0-9]+$"
        ],
        "scope": "file"
      },
      "message": "Variable '{target}' in {file} contains what appears to be a hardcoded credential. Load secrets from process.env or a secret manager instead.",
      "tags": [
        "owasp-a07",
        "secrets",
        "production-critical"
      ]
    },
    {
      "id": "ts-generic-fallback-secret",
      "name": "Hardcoded fallback when environment variable is missing in TypeScript/JavaScript",
      "language": "typescript",
      "framework": "*",
      "pattern_type": "hardcoded_secret",
      "severity": "HIGH",
      "description": "process.env.VAR is used with a hardcoded fallback (|| or ??), embedding a credential in source code for cases where the environment variable is absent. This pattern is common in development and frequently reaches production.",
      "detection": {
        "check_type": "hardcoded_secret",
        "secret_patterns": [
          "(?i)^postgres(?:ql)?://[^:/]+:[^@/]{4,}@",
          "(?i)^mysql://[^:/]+:[^@/]{4,}@",
          "(?i)^mongodb(?:\\+srv)?://[^:/]+:[^@/]{4,}@",
          "(?i)^amqps?://[^:/]+:[^@/]{4,}@",
          "(?i)^redis://[^:/]*:[^@/]{4,}@",
          "^SG\\.[a-zA-Z0-9_-]{22,}\\.[a-zA-Z0-9_-]{22,}$",
          "^key-[a-zA-Z0-9]{32,}$",
          "^-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
          "^https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[a-zA-Z0-9]+$"
        ],
        "detect_fallback": true,
        "scope": "file"
      },
      "message": "'{target}' in {file} uses a hardcoded fallback value when the environment variable is absent. Remove the fallback \u2014 throw an error at startup if the required secret is not configured.",
      "tags": [
        "owasp-a07",
        "secrets",
        "fallback-credential"
      ]
    },
